{
  "name": "wardline",
  "version": "0.1.0",
  "description": "Security auditor for AI coding-agent configurations. Audits permissions, hooks, MCP servers, agent prompts and committed secrets.",
  "keywords": ["security", "static-analysis", "ai-agents", "mcp", "prompt-injection", "secrets", "sast", "cli"],
  "license": "MIT",
  "author": "Sagnik Bhowmik",
  "type": "module",
  "bin": {
    "wardline": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "scan": "tsx src/cli.ts scan",
    "scan:demo": "tsx src/cli.ts scan --path examples/insecure-config",
    "rules": "tsx src/cli.ts rules",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^2.1.8",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
